{
  "name": "scratchpad",
  "displayName": "Cursor Scratchpad",
  "description": "A thought dump for Cursor. Catch ideas mid-task, revisit later; the agent can read them too.",
  "version": "0.1.6",
  "publisher": "ryanlockqr",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f20",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanlockqr/cursor-scratchpad.git"
  },
  "bugs": {
    "url": "https://github.com/ryanlockqr/cursor-scratchpad/issues"
  },
  "homepage": "https://github.com/ryanlockqr/cursor-scratchpad#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "scratchpad",
    "inbox",
    "agent",
    "rules",
    "skills",
    "capture",
    "adhd"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scratchpad",
          "title": "Cursor Scratchpad",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "scratchpad": [
        {
          "type": "webview",
          "id": "scratchpad.sidebar",
          "name": "Cursor Scratchpad",
          "contextualTitle": "Cursor Scratchpad"
        }
      ]
    },
    "commands": [
      {
        "command": "scratchpad.quickDump",
        "title": "Quick Dump Thought",
        "category": "Cursor Scratchpad"
      },
      {
        "command": "scratchpad.clearDump",
        "title": "Clear Dump",
        "category": "Cursor Scratchpad"
      },
      {
        "command": "scratchpad.focusSidebar",
        "title": "Focus Sidebar",
        "category": "Cursor Scratchpad"
      }
    ],
    "configurationDefaults": {
      "files.exclude": {
        "**/.cursor/scratchpad.md": true
      },
      "search.exclude": {
        "**/.cursor/scratchpad.md": true
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Writes Cursor dump, rule, and skill files into the project."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Needs a local project folder so Cursor can read the dump, rule, and skill."
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ -watch",
    "lint": "tsc --noEmit -p ./",
    "icon": "python3 scripts/generate-icon.py",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.5",
    "typescript": "^5.7.2"
  }
}
